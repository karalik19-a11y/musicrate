{
  "name": "@musicrate/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.1",
    "music-metadata": "^11.6.0",
    "nanoid": "^5.1.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.5",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}

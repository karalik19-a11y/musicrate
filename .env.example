# ---------- MUSICRATE server ----------
# Copy to `.env` for local runs (the server reads process.env; use `node --env-file=.env` or your platform's env UI).

# HTTP port / bind address
PORT=8080
HOST=0.0.0.0

# Shared artist access code. Checked ONLY on the backend (POST /api/auth/artist).
# Change it in production!
ARTIST_PASSWORD=00112233

# Where the SQLite database and uploaded audio files live.
# Mount a persistent volume here on Fly.io / Railway / Render (e.g. /data).
DATA_DIR=./data

# Optional: use Turso / remote libsql instead of the embedded SQLite file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Optional limits
MAX_UPLOAD_MB=80
SESSION_TTL_DAYS=365

# ---------- Telegram bot (optional) ----------
# Create a bot with @BotFather (https://t.me/BotFather) → /newbot, then paste
# its token here. With a token the server starts long-polling Telegram:
#   /start  → the chat is subscribed and gets an "open the app" button
#   /stop   → unsubscribe
# Every newly published track is announced to all subscribers with a button
# that opens the web app straight on that track.
# No token → no bot; the rest of the server is unaffected.
# TELEGRAM_BOT_TOKEN=123456789:AAEhBOweik6ad9r_QXMENQjcrGbqCr4K-4c

# HTTPS URL of the web app the bot's buttons open (Telegram only launches
# HTTPS mini apps). Defaults to the public GitHub Pages build.
# TELEGRAM_WEBAPP_URL=https://karalik19-a11y.github.io/musicrate/

# Origin of the Bot API — only useful with a self-hosted local Bot API server.
# TELEGRAM_API_URL=https://api.telegram.org

# Optional: path to the built client (defaults to ./client/dist)
# CLIENT_DIST=./client/dist

# Origins that may call the API from a browser. The static GitHub Pages build
# lives on another origin, so add it here when you point the Pages link at this
# API. `*` (default) is fine: auth is a bearer header, never a cookie.
# ALLOWED_ORIGINS=https://karalik19-a11y.github.io,https://musicrate.example.com

# ---------- Vite dev server only ----------
# Where `/api/*` is proxied to while running `npm run dev`
API_URL=http://localhost:8080

# ---------- Client build (optional) ----------
# Nothing is required for a same-origin production server: with no VITE_API_URL
# the client probes same-origin /api/health and otherwise uses the local engine.
# The GitHub Pages build is the exception: scripts/pages-build.mjs supplies the
# shared API URL explicitly so different devices do not get separate databases.

# Bake an API origin into the bundle. Set it and the app never falls back to local
# storage silently — if the API is down it says so. The GitHub Pages build uses
# https://musicrate.onrender.com by default; override this for your own API.
# VITE_API_URL=https://musicrate.onrender.com

# Local (static) mode only: SHA-256 of the artist access code the on-device
# engine accepts. Default is the hash of 00112233. The code itself is never shipped.
# VITE_ARTIST_CODE_HASH=$(node -e "const c=require('crypto');process.stdout.write(c.createHash('sha256').update(process.argv[1]).digest('hex'))" '00112233')

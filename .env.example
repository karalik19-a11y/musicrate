# ---------- MUSICRATE server ----------
# Copy to `.env` for local runs (the server reads process.env; use `node --env-file=.env` or your platform's env UI).

# HTTP port / bind address
PORT=8080
HOST=0.0.0.0

# Shared artist access code. Checked ONLY on the backend (POST /api/auth/artist).
# Change it in production!
ARTIST_PASSWORD=00112233

# Where the SQLite database and uploaded audio files live.
# Mount a persistent volume here on Fly.io / Railway / Render (e.g. /data).
DATA_DIR=./data

# Optional: use Turso / remote libsql instead of the embedded SQLite file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Optional limits
MAX_UPLOAD_MB=80
SESSION_TTL_DAYS=365

# Optional: path to the built client (defaults to ./client/dist)
# CLIENT_DIST=./client/dist

# ---------- Vite dev server only ----------
# Where `/api/*` is proxied to while running `npm run dev`
API_URL=http://localhost:8080
